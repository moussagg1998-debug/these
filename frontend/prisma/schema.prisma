generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Chariow subscription — plan Essentiel. "FREE" | "ESSENTIEL". Each
  // successful Chariow payment extends planExpiresAt by 30 days (from the
  // current expiry if still active, otherwise from now). Written ONLY by
  // lib/server/subscriptions/reconcile.ts and lib/server/subscriptions/expire.ts
  // — never by a route that trusts client input directly.
  plan          String    @default("FREE") // FREE | ESSENTIEL
  planExpiresAt DateTime? // null while FREE

  // ThèseFacile — product-level profile, independent of the admin `role`
  // above. Null until the user completes "Choix du profil" onboarding.
  // Fixed at onboarding time (one account = one profile) per product decision.
  profileType   String? // "ENCADRANT" | "ETUDIANT"
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Phase 10 — encadrant "Profil" tab (Settings). Generic on User (matching
  // the flat profileType/institutionId convention above) rather than a
  // separate EncadrantProfile table, even though only the encadrant UI
  // edits them today. All optional — no onboarding step requires them.
  department    String?
  academicGrade String?
  specialties   String[] @default([])
  bio           String?

  // Phase 13 — real consent record for the signup CGU checkbox. Null for
  // accounts created before this field existed (OAuth first-sign-ins, or
  // rows from before this migration).
  termsAcceptedAt DateTime?

  // Settings → "Général" display preferences. `dateFormat` defaults to
  // "long" (matches the pre-existing hardcoded fr-FR spelled-out format, e.g.
  // "8 août 2026") so shipping this feature doesn't visually change any
  // existing date on any screen unless a user explicitly opts into a
  // different format. `locale` is a single-value enum today ("fr") — no
  // i18n/translation system exists yet, so this only records the
  // preference for when one does; it does not change any UI text.
  locale     String @default("fr")
  timezone   String @default("Africa/Dakar")
  dateFormat String @default("long") // "long" | "DD/MM/YYYY" | "MM/DD/YYYY" | "YYYY-MM-DD"

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  uploadErrorEvents UploadErrorEvent[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  couponRedemptions CouponRedemption[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  securityEvents    SecurityEvent[]

  // ThèseFacile domain relations — a User can appear as either side
  // depending on `profileType`, never both (see IMPLEMENTATION-PLAN.md §6).
  thesesAsStudent   Thesis[]  @relation("ThesisStudent")
  thesesAsEncadrant Thesis[]  @relation("ThesisEncadrant")
  authoredComments  Comment[]
  sentMessages      Message[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Security event log — Admin → Sécurité. Append-only history of
// self-service auth events (login success/failure, password changes),
// distinct from AdminAction (which is scoped to a back-office admin
// acting on a target). Powers the /admin/security KPI cards and the
// live anomaly-detection rules in lib/server/security/anomalies.ts.
//
// `userId` is null for LOGIN_FAILED against an email that doesn't match
// any account — `email` is always captured so the row is still useful
// for spray/enumeration-attempt triage.
// ───────────────────────────────────────────────────────────────────────
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // LOGIN_SUCCESS | LOGIN_FAILED | PASSWORD_CHANGED
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Upload error log — Admin → Gestion des documents. Append-only history of
// failed POST /api/upload attempts (same "SecurityEvent for a different
// pipeline" shape). `source` distinguishes the two error categories the
// admin page reports separately:
//   VALIDATION — our own pre-flight gates rejected the request (missing
//     file, size cap, MIME allowlist, magic-byte mismatch, HEIC transcode
//     failure, Cloudinary not configured) — Cloudinary was never called.
//   CLOUDINARY — the request passed every local gate but Cloudinary's own
//     upload_stream call threw.
// FileUpload itself only records successes (it's an insert-on-success
// ledger), so failed attempts had no persistence anywhere before this.
model UploadErrorEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  code      String // UPLOAD_MISSING_FILE | FILE_TOO_LARGE | INVALID_MIME | MAGIC_BYTE_MISMATCH | HEIC_CONVERSION_FAILED | STORAGE_NOT_CONFIGURED | UPLOAD_FAILED
  source    String // VALIDATION | CLOUDINARY
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Admin monitoring center — Admin → Monitoring. Populated exclusively by
// /api/cron/monitoring-check (+ the SUPERADMIN-only manual "Vérifier
// maintenant" trigger) via frontend/src/lib/server/monitoring/run-checks.ts.
// Never written from a client request directly.
//
// `service` is one of: application | neon | vercel | github | cloudinary |
// resend | upstash | bictorys (see lib/server/monitoring/types.ts).
//
// No raw per-check log table on purpose — `consecutiveFailures` is the only
// state the threshold state machine needs, and `MonitoringIncident` rows
// already ARE the incident history. Incidents are low-frequency, so unlike
// WebhookLog/EmailJob this needs no retention-purge cron.
// ───────────────────────────────────────────────────────────────────────
model MonitoringServiceStatus {
  service             String    @id
  status              String    @default("UNVERIFIED") // OPERATIONAL | WARNING | CRITICAL | UNVERIFIED
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  lastLatencyMs       Int?
  lastError           String? // sanitized + truncated — see monitoring/sanitize.ts. Never a raw provider payload or secret.
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model MonitoringIncident {
  id             String    @id @default(cuid())
  service        String
  severity       String    @default("CRITICAL") // CRITICAL | WARNING — run-checks.ts opens both today (Admin -> Centre d'alertes)
  // OPEN = auto-detected, not yet acknowledged ("nouvelle"). ACKNOWLEDGED =
  // an admin clicked "Prendre en charge" ("en cours") — PATCH .../acknowledge,
  // audited via logAdminAction. RESOLVED = either the underlying check
  // recovered (auto) or an admin clicked "Marquer comme traitée" (manual,
  // PATCH .../resolve, audited) — both paths set resolvedAt/durationMs the
  // same way so the UI can't tell which happened, which is intentional: from
  // an admin's perspective "résolue" means the same thing either way.
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  detectedError  String // sanitized + truncated, same as MonitoringServiceStatus.lastError
  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())

  @@index([service, status])
  @@index([status, detectedAt])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  // Delivery tracking (Resend webhook, POST /api/webhooks/resend). `resendId`
  // is captured from the Mailer.send() response at the moment status flips
  // to SENT — it's the correlation key the webhook uses to find this row via
  // `data.email_id`. Both fields stay null until (a) the send actually
  // succeeds and (b) a delivery-status webhook event arrives, so their
  // absence is itself meaningful: null resendId = never sent or Resend
  // webhook not configured; null deliveryStatus = sent but no delivery
  // confirmation received yet (which is the truthful default — Resend does
  // not guarantee webhook delivery order or latency).
  resendId         String?   @unique
  deliveryStatus   String? // DELIVERED | BOUNCED | COMPLAINED | DELAYED
  deliveryStatusAt DateTime?

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id             String       @id @default(cuid())
  userId         String? // nullable — guest checkout supported
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // ThèseFacile — set when this Order is an institution subscription charge
  // rather than a generic e-commerce purchase. Null for non-subscription
  // orders (keeps Order generic per CLAUDE.md "fair to modify" guidance).
  institutionId  String?
  institutionRef Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  amount         Int // gross amount, smallest unit
  currency       String       @default("XOF") // ISO 4217
  status         String       @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail  String?
  customerPhone  String?
  customerName   String?
  metadata       Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String?           @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)
  couponRedemption CouponRedemption?

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Discount coupons — percentage-off codes applied at subscription checkout.
// A coupon redemption bypasses the payment provider entirely (see
// lib/server/subscriptions/coupons.ts): Chariow's hosted checkout can't
// accept a per-transaction amount, so a validated coupon creates the Order
// directly PAID (provider "coupon") and activates the plan synchronously.
// `redemptions` is the source of truth for usage counts — no denormalized
// counter on Coupon itself, to avoid a second field that could drift out of
// sync with the actual redemption rows.
// ───────────────────────────────────────────────────────────────────────
model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique // stored uppercase, e.g. "THESIS"
  discountPercent Int // 1-100
  isActive        Boolean            @default(true)
  maxRedemptions  Int? // null = unlimited
  expiresAt       DateTime? // null = never
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  redemptions     CouponRedemption[]

  @@index([code])
}

// One row per successful redemption. `@@unique([couponId, userId])` is a
// DB-level backstop for the "one use per user" rule — the primary
// enforcement is the `coupon:{code}` advisory lock held around the whole
// checkout transaction (lib/server/subscriptions/lock.ts), which already
// makes a same-coupon race impossible; the constraint just documents the
// invariant and catches any future bypass of that lock.
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  redeemedAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// ThèseFacile domain models — thesis/mémoire supervision.
// See .planning/banani/IMPLEMENTATION-PLAN.md for the Banani → schema
// mapping and the confirmed product decisions (§6).
// ───────────────────────────────────────────────────────────────────────

// One per university/école — encadrants belong to an Institution; a future
// subscription (Order.institutionId) bills at this level.
model Institution {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  encadrants User[]
  orders     Order[]
}

model Thesis {
  id          String    @id @default(cuid())
  topic       String
  // "En attente" | "Rédaction" | "Révision" | "Bloqué" | "Soutenance"
  stage       String    @default("En attente")
  progress    Int       @default(0) // 0-100
  studentId   String
  student     User      @relation("ThesisStudent", fields: [studentId], references: [id], onDelete: Cascade)
  encadrantId String
  encadrant   User      @relation("ThesisEncadrant", fields: [encadrantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Set when the encadrant "retire" the student from active supervision.
  // Reversible (soft-delete) — null = active. Excluded from every
  // cross-thesis list/aggregate query; documents/comments/deadlines/messages
  // are kept, not cascade-deleted.
  archivedAt  DateTime?

  documents Document[]
  comments  Comment[]
  deadlines Deadline[]
  messages  Message[]

  @@index([encadrantId, createdAt])
  @@index([studentId])
}

model Document {
  id                String     @id @default(cuid())
  thesisId          String
  thesis            Thesis     @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  chapter           String? // e.g. "Chapitre 3"
  // Cloudinary URL — produced by the existing /api/upload flow, not a new
  // storage path. See CLAUDE.md "Files Claude SHOULD modify" — upload/sniff.ts.
  fileUrl           String
  // Both optional: Cloudinary's upload response carries `original_filename`/
  // `bytes`, populated by the student upload flow (Phase 8) — older rows
  // (or any created another way) fall back to deriving a display name from
  // `chapter`/`fileUrl` and omitting size when these are null.
  fileName          String?
  sizeBytes         Int?
  uploadedAt        DateTime   @default(now())
  // "Programmer le dépôt" — file is uploaded to storage immediately, but the
  // Document only becomes visible to the encadrant (and DOCUMENT_SUBMITTED
  // fires) once the scheduled-deposits cron releases it at this time. Null
  // means an ordinary, immediately-visible deposit — the common case.
  scheduledAt       DateTime?
  // Set only on an encadrant-authored correction — points at the student
  // deposit it replies to. Null = ordinary student deposit (the only kind
  // that existed before this field, so no backfill is needed). This field,
  // not a separate "author" field, is what distinguishes who sent a
  // Document row — see docs/superpowers/specs/
  // 2026-08-15-encadrant-document-corrections-design.md.
  // NOTE: onDelete: SetNull mirrors the Comment.documentId precedent below,
  // but here it's a landmine — replyToDocumentId being non-null is the ONLY
  // signal that a Document is a correction. If a document-delete feature is
  // ever added, deleting a reply target must not silently reclassify its
  // corrections as student deposits — either cascade-delete replies or
  // block deletion of a document that has any. Nothing in this codebase
  // deletes a Document today, so this cannot happen yet.
  replyToDocumentId String?
  replyTo           Document?  @relation("DocumentReplies", fields: [replyToDocumentId], references: [id], onDelete: SetNull)
  replies           Document[] @relation("DocumentReplies")
  comments          Comment[]

  @@index([thesisId, uploadedAt])
  @@index([scheduledAt])
  @@index([replyToDocumentId])
}

model Comment {
  id         String    @id @default(cuid())
  thesisId   String
  thesis     Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  // NB: `documentId` had no Prisma `@relation` until Phase 7 — a latent bug
  // (GET /api/comments's `include: { document: {...} } }`, shipped in Phase
  // 4, would have thrown at runtime against a real DB; fully-mocked tests
  // never caught it). Fixed alongside the Phase 7 student dashboard, which
  // needed the same relation.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  body       String
  // Encadrant-only triage fields for "Commentaires — Vue d'ensemble".
  resolved   Boolean   @default(false)
  priority   String    @default("medium") // "low" | "medium" | "high"
  createdAt  DateTime  @default(now())

  @@index([thesisId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Deadline {
  id            String    @id @default(cuid())
  thesisId      String
  thesis        Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueAt         DateTime
  urgency       String    @default("medium") // "low" | "medium" | "high"
  // Set by the encadrant (PATCH /api/deadlines/[id]) once the student has
  // genuinely met this deadline — stops it from showing as "En retard" once
  // dueAt passes. Same authority model as Comment.resolved.
  completedAt   DateTime?
  // Set at creation (POST /api/theses/[id]/deadlines) — opt out of the
  // automatic "3 jours avant" reminder the deadline-reminder cron sends the
  // encadrant for this specific deadline. Defaults on so existing behavior
  // (every deadline gets reminded) is unchanged unless explicitly disabled.
  remindEnabled Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([thesisId, dueAt])
}

model Message {
  id       String @id @default(cuid())
  thesisId String
  thesis   Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // Empty string allowed when an attachment carries the message (attachment-
  // only send) — the route requires body OR attachmentUrl to be present.
  body     String

  // Optional single image attachment, uploaded via POST /api/upload (same
  // Cloudinary pipeline as documents/avatars) before the message is created.
  attachmentUrl      String?
  attachmentFilename String?
  attachmentMimeType String?

  createdAt DateTime @default(now())

  @@index([thesisId, createdAt])
  @@index([senderId])
}
